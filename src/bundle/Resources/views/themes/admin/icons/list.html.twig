{% extends "@ibexadesign/ui/layout.html.twig" %}

{% trans_default_domain 'masilia_ibexa_icons' %}

{% block body_class %}masilia-icons-view{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('ibexa-admin-ui-masilia-icons-react-css', null, 'ibexa') }}
{% endblock %}

{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.admin'|trans },
        { value: 'icons.title'|trans }
    ]} %}
{% endblock %}

{% block title %}{{ 'icons.title'|trans }}{% endblock %}

{% block header %}
    {% include '@ibexadesign/ui/page_title.html.twig' with { title: 'icons.title'|trans } %}
{% endblock %}

{% block content %}
    {# The container of the admin pages (the width, the margins and the card of every list of the admin), then the React application:
       it loads its data from the JSON API. #}
    <section class="container ibexa-container">
        <div id="masilia-icons-root" data-api="{{ path('masilia.ibexa_icons.api.data') }}"></div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('ibexa-admin-ui-masilia-icons-react-js', null, 'ibexa') }}
{% endblock %}
