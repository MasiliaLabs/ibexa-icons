{# The icons page is a React application: it loads its data from the JSON API. It sits in the container of the admin lists (their width, margins and card). #}
{% extends '@ibexadesign/masilia_kit/page.html.twig' %}

{% trans_default_domain 'masilia_ibexa_icons' %}

{% set kit_title = 'icons.title'|trans %}
{% set kit_entry = 'masilia-icons-react' %}
{% set kit_body_class = 'masilia-icons-view' %}
{% set kit_container = true %}
{% set kit_root = { id: 'masilia-icons-root', data: { api: path('masilia.ibexa_icons.api.data') } } %}
